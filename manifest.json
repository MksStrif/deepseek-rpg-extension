{
  "manifest_version": 3,
  "name": "DeepSeek RPG Helper",
  "version": "4.3",
  "description": "RPG движок для DeepSeek и Алисы (Яндекс)",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://alice.yandex.ru/*",
    "*://*.google.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://alice.yandex.ru/*"],
      "js": ["scripts/content.js"]
    }
  ],
  "action": {
    "default_title": "Открыть RPG панель"
  }
}
